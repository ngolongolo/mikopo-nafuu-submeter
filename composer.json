{
  "name": "bluetick/mikopo-nafuu",
  "type": "project",
  "description": "Mikopo Nafuu loan marketplace",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0",
    "ext-pdo": "*",
    "ext-mbstring": "*",
    "ext-dom": "*",
    "ext-fileinfo": "*"
  },
  "require-dev": {
    "mockery/mockery": "^1.6",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "test": [
      "@php vendor/bin/phpunit"
    ]
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "preferred-install": "dist"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
